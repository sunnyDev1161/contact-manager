generator client {
  provider = "prisma-client-js"
}

// SQLite: a single local file, no database server to install or run. Right
// choice for one laptop. If this is ever hosted (see render.yaml), switch
// provider back to "postgresql" and DATABASE_URL to a real connection
// string — SQLite's ephemeral disk on most hosts would lose data on restart.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so Role and Unit are plain strings here.
// Valid values are enforced at the API layer (zod schemas in the routes),
// same as they'd be validated client-side regardless of the DB engine.
// Role: "OWNER" | "STAFF"
// Unit: "PCS" | "KG" | "G" | "LITRE" | "ML"

// A Business is a tenant. Every table below is scoped to one, so the schema
// is already tenant-safe even though the app is currently run for one shop.
model Business {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())

  users    User[]
  products Product[]
  sales    Sale[]
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  createdAt    DateTime @default(now())

  sales Sale[]

  @@index([businessId])
}

// Money and quantity fields are Float here (SQLite has no native Decimal
// type). All arithmetic on them is rounded to fixed precision in
// sale.routes.js (2dp for money, 3dp for quantity) to keep floating-point
// drift out of totals — fine at grocery-shop scale, not bank-grade.
model Product {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  sku               String?
  unit              String   @default("PCS")
  pricePerUnit      Float
  costPerUnit       Float
  stockQty          Float
  lowStockThreshold Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems SaleItem[]

  @@index([businessId])
  @@unique([businessId, sku])
}

model Sale {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  totalAmount Float
  totalCost   Float
  totalProfit Float
  createdAt   DateTime @default(now())

  items SaleItem[]

  @@index([businessId])
  @@index([createdAt])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unit        String
  quantity    Float
  unitPrice   Float
  unitCost    Float
  lineTotal   Float
  lineProfit  Float

  @@index([saleId])
  @@index([productId])
}
