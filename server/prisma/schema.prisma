generator client {
  provider = "prisma-client-js"
}

// SQLite: a single local file, no database server to install or run. Right
// choice for one laptop. If this is ever hosted (see render.yaml), switch
// provider back to "postgresql" and DATABASE_URL to a real connection
// string — SQLite's ephemeral disk on most hosts would lose data on restart.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so Role and Unit are plain strings here.
// Valid values are enforced at the API layer (zod schemas in the routes),
// same as they'd be validated client-side regardless of the DB engine.
// Role: "OWNER" | "STAFF"
// Unit: "PCS" | "KG" | "G" | "LITRE" | "ML"

// A Business is a tenant. Every table below is scoped to one, so the schema
// is already tenant-safe even though the app is currently run for one shop.
model Business {
  id          String   @id @default(uuid())
  name        String
  tagline     String? // e.g. "TRADING • SUPPLY • GENERAL MERCHANDISE" — shown on the printed bill
  proprietors String? // e.g. "Full Name | Full Name"
  address     String?
  phone       String? // free text — shop may list more than one number
  nextInvoiceNo Int    @default(1) // next sequential invoice number to assign; incremented atomically per sale
  createdAt   DateTime @default(now())

  users         User[]
  products      Product[]
  sales         Sale[]
  customers     Customer[]
  ledgerEntries LedgerEntry[]
}

model User {
  id           String   @id @default(uuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true) // OWNER can deactivate a staff account to revoke access without losing their sales history
  createdAt    DateTime @default(now())

  sales         Sale[]
  ledgerEntries LedgerEntry[] // payments/credits this user recorded
  voidedSales   Sale[]        @relation("SaleVoidedBy")

  @@index([businessId])
}

// A shopkeeper/wholesale customer this business sells to on account. Not
// every sale has one (walk-in cash sales don't), but any sale sold on
// credit must, since credit is tracked per customer.
model Customer {
  id             String   @id @default(uuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopName       String
  shopkeeperName String?
  phone          String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  sales         Sale[]
  ledgerEntries LedgerEntry[]

  @@index([businessId])
}

// The credit ledger. Every sale-on-credit and every payment received is its
// own row here — balance owed is SUM(SALE) - SUM(PAYMENT), computed on read,
// never stored as a single mutable number. That way it can never drift out
// of sync with reality, and there's always a full history to point to if a
// shopkeeper disputes what they owe.
model LedgerEntry {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String // "SALE" (increases balance owed) | "PAYMENT" or "VOID" (both decrease it — VOID is the compensating entry created when a credit sale is voided)
  amount     Float // always positive; `type` determines the sign
  saleId     String?
  sale       Sale?    @relation(fields: [saleId], references: [id])
  note       String?
  recordedByUserId String
  recordedBy User     @relation(fields: [recordedByUserId], references: [id])
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([customerId])
}

// Money and quantity fields are Float here (SQLite has no native Decimal
// type). All arithmetic on them is rounded to fixed precision in
// sale.routes.js (2dp for money, 3dp for quantity) to keep floating-point
// drift out of totals — fine at grocery-shop scale, not bank-grade.
// pricePerUnit = Retail Price (charged to walk-in customers).
// tradePricePerUnit = Trade Price (discounted price for shopkeeper/bulk
// buyers who resell it). costPerUnit = what the business paid its own
// supplier, used for profit calculation regardless of which price a sale
// was charged at.
model Product {
  id                String   @id @default(uuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  sku               String?
  unit              String   @default("PCS")
  pricePerUnit      Float
  tradePricePerUnit Float
  costPerUnit       Float
  stockQty          Float
  lowStockThreshold Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  saleItems SaleItem[]

  @@index([businessId])
  @@unique([businessId, sku])
}

model Sale {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  customerId  String? // set when this sale is attributed to a shopkeeper account; null for a walk-in/cash sale
  customer    Customer? @relation(fields: [customerId], references: [id])
  saleType    String    @default("RETAIL") // "RETAIL" | "TRADE" — which price basis this whole sale was charged at
  invoiceNo   Int // sequential per business (1, 2, 3, ...) — the real bill number printed on the receipt, distinct from the internal id
  totalAmount Float
  totalCost   Float
  totalProfit Float
  amountPaid  Float     @default(0) // cash actually collected at checkout; totalAmount - amountPaid is what was put on the customer's credit (0 for a fully-paid sale)
  voidedAt       DateTime? // set when an owner voids this sale (stock restocked, any credit reversed); the sale row itself is kept for the audit trail, never deleted
  voidedByUserId String?
  voidedBy       User?     @relation("SaleVoidedBy", fields: [voidedByUserId], references: [id])
  voidReason     String?
  createdAt   DateTime  @default(now())

  items         SaleItem[]
  ledgerEntries LedgerEntry[]

  @@index([businessId])
  @@index([createdAt])
  @@index([customerId])
  @@unique([businessId, invoiceNo])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unit        String
  priceType   String  @default("RETAIL") // "RETAIL" | "TRADE" — which price this line was charged at
  quantity    Float
  unitPrice   Float // the price actually charged (equals retailUnitPrice or tradeUnitPrice per priceType) — authoritative for totals/profit
  retailUnitPrice Float // snapshot of both prices at sale time, so a printed bill stays historically accurate even if prices change later
  tradeUnitPrice  Float
  unitCost    Float
  lineTotal   Float
  lineProfit  Float

  @@index([saleId])
  @@index([productId])
}
